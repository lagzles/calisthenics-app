{
  "name": "calisthenics-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aplicativo pessoal de calistenia (PWA offline, dark mode, mobile-first).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
